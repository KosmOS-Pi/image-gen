[connection]
id=SelfHotspot
uuid=da26b762-1838-4410-b878-baec532158d3
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority=-90
permissions=

[wifi]
mode=ap
ssid=KosmOS-Hotspot

[wifi-security]
key-mgmt=wpa-psk
psk=KosmOS-AP-Password

[ipv4]
method=shared

[ipv6]
method=ignore

[proxy]
